# --- Firebase (client) — visibles dans le navigateur, sans risque ---
# Console Firebase > Paramètres du projet > Vos applications > Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (serveur uniquement) — SECRET, jamais exposé au client ---
# Console Firebase > Paramètres du projet > Comptes de service > Générer une nouvelle clé privée
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Coller la clé privée telle quelle ; sur Vercel, les \n du JSON deviennent
# des \n littéraux dans la variable d'env — c'est géré automatiquement par
# lib/firebase-admin.ts.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Site ---
# URL de CE projet (IRIS JOIN), sans slash final, SANS « www. ».
# Elle sert à construire les liens des e-mails (/resultats, /entretien) ainsi
# que le logo et les icônes de la signature (/logo-iris.png, /email/icon-*.png).
# Ne pas mettre le site officiel.
NEXT_PUBLIC_SITE_URL=https://join.iris-junior-entreprise.com

# --- Fenêtre de recrutement (format ISO 8601 avec fuseau horaire) ---
NEXT_PUBLIC_RECRUITMENT_OPEN=2026-10-01T00:00:00+01:00
NEXT_PUBLIC_RECRUITMENT_CLOSE=2026-10-31T23:59:59+01:00

# --- Email transactionnel (SMTP) ---
# Exemples de host/port courants :
#   Gmail (avec mot de passe d'application) : smtp.gmail.com / 587
#   Outlook/Office 365                       : smtp.office365.com / 587
#   OVH                                       : ssl0.ovh.net / 465
#   SendGrid (en mode SMTP)                   : smtp.sendgrid.net / 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Adresse affichée comme expéditeur (souvent identique à SMTP_USER)
SMTP_FROM="RH et Formations IRISJE <recrutement@irisje.com>"

# Email de l'équipe RH qui reçoit une notification à chaque nouvelle candidature.
# Laisser vide pour désactiver cette notification.
RH_NOTIFICATION_EMAIL=

# Adresses des administrateurs (séparées par des virgules)
ADMIN_EMAILS=

# --- Rappel d'entretien (24h avant) ---
# Secret partagé avec le planificateur qui appelle GET /api/cron/reminders.
# Sur Vercel : définissez cette variable et Vercel Cron l'enverra automatiquement
# en "Authorization: Bearer <valeur>". Avec un planificateur externe
# (cron-job.org, GitHub Actions…), configurez le même en-tête manuellement.
# Laisser vide désactive la vérification (déconseillé en production).
# Générer une valeur : openssl rand -hex 32
CRON_SECRET=

# --- Signature des e-mails (pied de page, toujours au nom de la RH) ---
# Tous facultatifs : une variable vide ou absente = valeur par défaut du code
# (celles de la signature du bureau 2025 – 2026).
EMAIL_SIGNATURE_NAME=
EMAIL_SIGNATURE_ROLE=
EMAIL_SIGNATURE_ORG=
EMAIL_SIGNATURE_OFFICE=
EMAIL_SIGNATURE_ADDRESS=
EMAIL_SIGNATURE_PHONE=
# Lien du site affiché dans la signature (défaut : https://www.iris-junior-entreprise.com)
EMAIL_SIGNATURE_WEBSITE=
# Logo : URL absolue en https. Vide = ${NEXT_PUBLIC_SITE_URL}/logo-iris.png
EMAIL_LOGO_URL=
# Icônes sociales : toujours affichées (public/email/icon-*.png) ;
# cliquables seulement si l'URL est renseignée.
# EMAIL_LINKEDIN_URL vide = LINKEDIN_URL de lib/config.ts
EMAIL_FACEBOOK_URL=
EMAIL_LINKEDIN_URL=
EMAIL_INSTAGRAM_URL=