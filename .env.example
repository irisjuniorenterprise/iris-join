# --- Firebase (client) — visibles dans le navigateur, sans risque ---
# Console Firebase > Paramètres du projet > Vos applications > Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (serveur uniquement) — SECRET, jamais exposé au client ---
# Console Firebase > Paramètres du projet > Comptes de service > Générer une nouvelle clé privée
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Coller la clé privée telle quelle ; sur Vercel, les \n du JSON deviennent
# des \n littéraux dans la variable d'env — c'est géré automatiquement par
# lib/firebase-admin.ts.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://join.irisje.com

# --- Fenêtre de recrutement (format ISO 8601 avec fuseau horaire) ---
NEXT_PUBLIC_RECRUITMENT_OPEN=2026-10-01T00:00:00+01:00
NEXT_PUBLIC_RECRUITMENT_CLOSE=2026-10-31T23:59:59+01:00

# --- Email transactionnel (SMTP) ---
# Exemples de host/port courants :
#   Gmail (avec mot de passe d'application) : smtp.gmail.com / 587
#   Outlook/Office 365                       : smtp.office365.com / 587
#   OVH                                       : ssl0.ovh.net / 465
#   SendGrid (en mode SMTP)                   : smtp.sendgrid.net / 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Adresse affichée comme expéditeur (souvent identique à SMTP_USER)
SMTP_FROM="IRIS JOIN <recrutement@irisje.com>"

# Email de l'équipe RH qui reçoit une notification à chaque nouvelle candidature.
# Laisser vide pour désactiver cette notification.
RH_NOTIFICATION_EMAIL=

ADMIN_EMAILS=