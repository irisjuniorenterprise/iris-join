rules_version = '2';

// IRIS JOIN n'utilise Firestore QUE depuis le serveur (Firebase Admin SDK
// dans les routes API), qui contourne ces règles avec des droits complets.
// Le client (navigateur) n'a besoin que de Firebase Auth (Google Sign-In),
// jamais d'un accès direct à Firestore. On verrouille donc tout accès
// client par défaut, ce qui est la posture la plus sûre et évite qu'un
// bug futur n'expose des données de candidature.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
